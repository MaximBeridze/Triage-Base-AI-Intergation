# Google Gemini OpenAI-compatible endpoint. Keep the real key in .env.local.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Only these server-approved IDs may be selected in the browser.
LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_STRUCTURED_OUTPUT=json_schema
# Set both to 0 ONLY for a confirmed free-tier project.
# Otherwise enter USD per million tokens for the selected models.
# Leave blank to report cost as unavailable.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
SMOKE_DELAY_MS=4500

# Optional decision model; appears in the selector only with both credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# USD per million input tokens. 0 for confirmed free allocation, blank for unknown.
# Published list-price estimate: 0.038 (not an invoice or allowance calculation).
CLOUDFLARE_INPUT_PRICE_PER_MILLION=

